 def render_signals(block) -> str:
     """One status token for an unacked-signal block (the heartbeat's
     `unacked_signals` or a `signals_summary` result). Two shapes, both
     fail-closed on the render:
 
     - the by-source shape (sovereign-stack plan 1 Task 9, design A3: counts
-      per source, no headline total) renders `thread=205,watchman=110,...`,
-      and a null `by_source` (the ledger unreadable) renders UNKNOWN;
+      per source, no headline total) renders `open_threads=205,watchman=110,...`:
+      each source under the block's own `source_labels` name for it (A3: the
+      thread count is the open threads; a space becomes `_`, so a token stays
+      one word), or under its key where the block carries no label (the
+      bridge's fallback, an older stack). A source's value is its `open` count
+      when it is the nested detail `signals_summary` returns, so a null source
+      renders UNKNOWN on both routes. A null `by_source` (the ledger unreadable)
+      renders UNKNOWN;
     - the older shape with a `total` key renders `total/ingestion`, with a
       null total as UNKNOWN (the stack's own null-not-zero rule).
 
     A partial sweep says so in both. Anything that is not a dict is ABSENT
     (an older stack, or no block at all). Edited 2026-10-23 by HQ ahead of
     the plan 1 deploy so the pulse reads either stack without a restart.
     """
     if not isinstance(block, dict):
         return "ABSENT"
     ing = block.get("ingestion", "?")
     if "total" in block:
         total = block.get("total")
         out = ("UNKNOWN" if total is None else str(total)) + f"/{ing}"
     else:
         by_source = block.get("by_source")
         if isinstance(by_source, dict):
-            parts = [f"{src}={'UNKNOWN' if n is None else n}" for src, n in sorted(by_source.items())]
+            labels = block.get("source_labels")
+            labels = labels if isinstance(labels, dict) else {}
+            parts = []
+            for src, n in sorted(by_source.items()):
+                if isinstance(n, dict):  # signals_summary: the nested detail
+                    n = n.get("open")
+                name = str(labels.get(src) or src).replace(" ", "_")
+                parts.append(f"{name}={'UNKNOWN' if n is None else n}")
             out = (",".join(parts) if parts else "none") + f"/{ing}"
         else:
             out = f"UNKNOWN/{ing}"
     if block.get("partial"):
         out += "/PARTIAL"
     return out
 
 
